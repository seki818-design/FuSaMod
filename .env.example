# FuSaMod サーバー設定(すべて任意)。値は環境変数として渡す。
PORT=8787
HOST=127.0.0.1                 # 外部公開する場合は FUSAMOD_TOKENS を必ず設定する
FUSAMOD_PROJECTS=./projects    # プロジェクト(モデル・安全データ・履歴・監査ログ)の保存先
FUSAMOD_TOKENS=                # 例: alice:<16文字以上の乱数>,bob/viewer:<別の乱数>(viewer は読み取り専用。空なら認証なし=ローカル専用)
FUSAMOD_SYSML=auto             # auto | java | snapshot(Java 21 が無い場合は snapshot に縮退)
FUSAMOD_SYSML_CACHE=           # 公式実装 jar の保存先(既定 ~/.cache/fusamod/sysml-pilot-0.62.0)
FUSAMOD_CORS_ORIGIN=           # 別オリジンからの利用時のみ
FUSAMOD_AI_PROVIDER=rule       # rule(ルールベース、外部通信なし) | claude
ANTHROPIC_API_KEY=             # claude のときのみ。モデル・参照資料の抜粋が Anthropic API に送信される
FUSAMOD_AI_MODEL=claude-sonnet-5-5
FUSAMOD_AI_MAX_REF_CHARS=6000
FUSAMOD_WEB_DIST=           # Web UI の配置先(既定 apps/web/dist)
FUSAMOD_HISTORY_KEEP=500       # 残すリビジョン数
