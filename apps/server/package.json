{
  "name": "@fusamod/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --external:fastify --external:@fastify/static --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --log-level=warning",
    "start:dist": "node dist/server.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fusamod/ai": "workspace:*",
    "@fusamod/analysis": "workspace:*",
    "@fusamod/safety-core": "workspace:*",
    "@fusamod/scdl": "workspace:*",
    "@fusamod/sysml-graph": "workspace:*",
    "fastify": "^5.0.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
