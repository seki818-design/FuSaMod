{
  "name": "fusamod",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "SysML v2 ベースのシステムモデリング・機能安全分析ツール",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "pnpm --filter @fusamod/web build && pnpm --filter @fusamod/server build",
    "start": "pnpm --filter @fusamod/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:integration": "FUSAMOD_IT=1 pnpm --filter @fusamod/server test",
    "e2e": "pnpm --filter @fusamod/web e2e",
    "coverage": "node tools/quality/coverage.mjs",
    "bench": "node --import tsx tools/quality/bench.ts",
    "sysml:check": "tools/sysml-check/run.sh",
    "evidence": "node tools/quality/coverage.mjs --write && node --import tsx tools/quality/bench.ts --write",
    "quality": "pnpm typecheck && pnpm lint && pnpm test && pnpm coverage && pnpm bench",
    "shots": "SHOTS=1 pnpm --filter @fusamod/web e2e shots",
    "e2e:java": "pnpm --filter @fusamod/web e2e:java"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.8.0"
  }
}
